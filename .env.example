# Supabase (publishable key is safe for the browser; still keep out of screenshots)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only (never expose to client bundles)
SUPABASE_SECRET_KEY=

# AI providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GLADIA_API_KEY=

# Rate limiting — Upstash Redis (Vercel Marketplace). When both are set, guest AI
# endpoints are rate limited globally across serverless instances. If unset, the app
# falls back to a per-instance in-memory limiter (fine for local dev, not production).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Logging
LOG_LEVEL=info

# Error tracking — get a free DSN from sentry.io
NEXT_PUBLIC_SENTRY_DSN=
