# Supabase (publishable key is safe for the browser; still keep out of screenshots)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only (never expose to client bundles)
SUPABASE_SECRET_KEY=

# AI providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=

# Logging
LOG_LEVEL=info

# Error tracking — get a free DSN from sentry.io
NEXT_PUBLIC_SENTRY_DSN=
