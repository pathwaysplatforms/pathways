{
  "name": "pathways",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@sentry/nextjs": "^8",
    "@supabase/ssr": "^0.5",
    "@supabase/supabase-js": "^2",
    "next": "^14.2.0",
    "openai": "^4",
    "pino": "^9",
    "pino-pretty": "^11",
    "react": "^18",
    "react-dom": "^18",
    "zod": "^3"
  },
  "devDependencies": {
    "@playwright/test": "^1",
    "@types/node": "^22",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitest/coverage-v8": "^2",
    "@vitest/ui": "^2",
    "autoprefixer": "^10",
    "eslint": "^8",
    "eslint-config-next": "^14.2.0",
    "eslint-config-prettier": "^9",
    "happy-dom": "^14",
    "postcss": "^8",
    "prettier": "^3",
    "tailwindcss": "^3",
    "typescript": "^5",
    "vitest": "^2"
  }
}
