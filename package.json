{
  "name": "pathways",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node server.js",
    "build": "next build",
    "start": "NODE_ENV=production node server.js",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@paper-design/shaders-react": "^0.0.76",
    "@sentry/nextjs": "^10.59.0",
    "@supabase/ssr": "^0.5",
    "@supabase/supabase-js": "^2",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "lucide-react": "^1.16.0",
    "next": "^15.5.16",
    "openai": "^4",
    "pino": "^9",
    "pino-pretty": "^11",
    "react": "^18",
    "react-dom": "^18",
    "react-markdown": "^10.1.0",
    "recharts": "^3.9.2",
    "remark-gfm": "^4.0.1",
    "ws": "^8.21.0",
    "zod": "^3"
  },
  "overrides": {
    "form-data": ">=4.0.6",
    "js-yaml": ">=4.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1",
    "@types/node": "^22",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "^4.1.9",
    "autoprefixer": "^10",
    "eslint": "^8",
    "eslint-config-next": "^15.5.16",
    "eslint-config-prettier": "^9",
    "happy-dom": "^20.10.6",
    "postcss": "^8",
    "prettier": "^3",
    "tailwindcss": "^3",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
