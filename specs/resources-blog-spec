## 3. SVG Cover Art Generator

Create this utility at `lib/cover-art.ts`. Generates a unique deterministic abstract SVG from a seed string (the post slug). Same slug always produces the same cover. Uses the Pathways green palette.

```ts
// lib/cover-art.ts

const PALETTES = [
  // Deep green on light
  { bg: '#F2F6F5', shapes: ['#0D4A3A', '#2A5C4E', '#1C3D32', '#E8F0EE'] },
  // Light on deep green
  { bg: '#0D4A3A', shapes: ['#E8F0EE', '#F2F6F5', '#2A5C4E', '#ffffff'] },
  // Muted green tones
  { bg: '#E8F0EE', shapes: ['#0D4A3A', '#2A5C4E', '#1C3D32', '#F2F6F5'] },
  // Near-black with green
  { bg: '#0A0A0A', shapes: ['#0D4A3A', '#2A5C4E', '#E8F0EE', '#F2F6F5'] },
]

// Deterministic pseudo-random from string seed
function seededRandom(seed: string) {
  let hash = 0
  for (let i = 0; i < seed.length; i++) {
    const char = seed.charCodeAt(i)
    hash = ((hash << 5) - hash) + char
    hash = hash & hash
  }
  let s = Math.abs(hash)
  return () => {
    s = (s * 1103515245 + 12345) & 0x7fffffff
    return s / 0x7fffffff
  }
}

export function generateCoverSVG(seed: string, width = 800, height = 420): string {
  const rand = seededRandom(seed)
  const palette = PALETTES[Math.floor(rand() * PALETTES.length)]
  
  const elements: string[] = []

  // Background
  elements.push(`<rect width="${width}" height="${height}" fill="${palette.bg}"/>`)

  // Topographic contour lines (signature Pathways motif)
  const numContours = 4 + Math.floor(rand() * 4)
  for (let i = 0; i < numContours; i++) {
    const cx = rand() * width
    const cy = rand() * height
    const rx = 80 + rand() * 280
    const ry = 40 + rand() * 140
    const rotation = rand() * 360
    const color = palette.shapes[Math.floor(rand() * palette.shapes.length)]
    const opacity = 0.08 + rand() * 0.14
    elements.push(`
      <ellipse
        cx="${cx}" cy="${cy}"
        rx="${rx}" ry="${ry}"
        transform="rotate(${rotation} ${cx} ${cy})"
        fill="none"
        stroke="${color}"
        stroke-width="1.5"
        opacity="${opacity}"
      />
    `)
  }

  // Geometric shapes
  const numShapes = 3 + Math.floor(rand() * 4)
  for (let i = 0; i < numShapes; i++) {
    const shapeType = Math.floor(rand() * 3)
    const color = palette.shapes[Math.floor(rand() * palette.shapes.length)]
    const opacity = 0.06 + rand() * 0.18
    const size = 40 + rand() * 160

    if (shapeType === 0) {
      // Rectangle
      const x = rand() * width
      const y = rand() * height
      const rotation = rand() * 45
      elements.push(`
        <rect
          x="${x}" y="${y}"
          width="${size}" height="${size * (0.4 + rand() * 0.6)}"
          transform="rotate(${rotation} ${x + size/2} ${y + size/2})"
          fill="${color}"
          opacity="${opacity}"
          rx="4"
        />
      `)
    } else if (shapeType === 1) {
      // Circle
      elements.push(`
        <circle
          cx="${rand() * width}" cy="${rand() * height}"
          r="${size / 2}"
          fill="${color}"
          opacity="${opacity}"
        />
      `)
    } else {
      // Triangle
      const x = rand() * width
      const y = rand() * height
      elements.push(`
        <polygon
          points="${x},${y} ${x + size},${y} ${x + size/2},${y - size * 0.8}"
          fill="${color}"
          opacity="${opacity}"
        />
      `)
    }
  }

  // Subtle diagonal lines (depth texture)
  const numLines = 3 + Math.floor(rand() * 3)
  for (let i = 0; i < numLines; i++) {
    const x1 = rand() * width
    const y1 = rand() * height
    const color = palette.shapes[Math.floor(rand() * palette.shapes.length)]
    elements.push(`
      <line
        x1="${x1}" y1="${y1}"
        x2="${x1 + 100 + rand() * 200}" y2="${y1 + 60 + rand() * 120}"
        stroke="${color}"
        stroke-width="1"
        opacity="${0.06 + rand() * 0.1}"
      />
    `)
  }

  return `
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 ${width} ${height}"
      width="${width}"
      height="${height}"
    >
      ${elements.join('\n')}
    </svg>
  `.trim()
}

// Returns a data URI for use in <img src={...}>
export function generateCoverDataURI(seed: string): string {
  const svg = generateCoverSVG(seed)
  return `data:image/svg+xml;base64,${Buffer.from(svg).toString('base64')}`
}
```

