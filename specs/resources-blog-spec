// app/resources/page.tsx
import { createClient } from '@/lib/supabase/server'

export default async function ResourcesPage({ searchParams }) {
  const tab = searchParams.tab === 'resources' ? 'resource' : 'article'
  const supabase = createClient()

  const { data: posts } = await supabase
    .from('posts')
    .select('id, title, slug, excerpt, cover_seed, tags, type, source_name, published_at, body')
    .eq('status', 'published')
    .eq('type', tab)
    .order('published_at', { ascending: false })
    .limit(9)

  return <ResourcesPageClient posts={posts} activeTab={tab} />
}

